{
  "name": "@mcptoolshop/portrait-forge",
  "version": "0.1.0",
  "description": "Consistent character portraits from text descriptions via one pinned ComfyUI workflow (local or Comfy Cloud), a house-style LoRA, and a question-based acceptance gate.",
  "type": "module",
  "private": true,
  "bin": {
    "portrait-forge": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "author": "mcp-tool-shop",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcp-tool-shop-org/portrait-forge.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
